# Safe local demo defaults
DEMO_MODE=true
RUN_ONCE=false
POLL_INTERVAL_SECONDS=30
REQUEST_TIMEOUT_SECONDS=10
MAX_RETRIES=3
LOG_LEVEL=INFO
SQLITE_PATH=./data/alerts.db
NOTIFIER_URL=http://localhost:3000/api/v1/internal/notify
# Required: set the same random value (at least 32 characters) for collector and notifier.
NOTIFIER_SHARED_SECRET=
PORT=3000
NOTIFY_BODY_LIMIT_BYTES=65536
NOTIFY_RATE_PER_MINUTE=300
NOTIFY_MAX_CONCURRENT=8
NOTIFY_MAX_QUEUE=32
SHUTDOWN_TIMEOUT_MS=10000
ALERT_RETENTION_DAYS=90
RETENTION_BATCH_SIZE=1000
# Leave empty to log metadata only instead of forwarding. HTTPS is required by default.
ALERT_WEBHOOK_URL=
WEBHOOK_TIMEOUT_MS=10000
ALLOW_INSECURE_WEBHOOK_HTTP=false

# Provider adapters are disabled until configured; production provider URLs require HTTPS.
WALLET_ADAPTER_ENABLED=false
WALLET_API_URL=
WALLET_API_TOKEN=
WALLET_ADDRESSES=
X_ADAPTER_ENABLED=false
X_API_URL=
X_BEARER_TOKEN=
X_ACCOUNTS=
NFT_ADAPTER_ENABLED=false
NFT_API_URL=
NFT_API_TOKEN=
AGENT_ADAPTER_ENABLED=false
AGENT_API_URL=
AGENT_API_TOKEN=
